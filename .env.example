# Cliente (Vite): URL pública de la API propia.
VITE_API_BASE_URL=http://localhost:3001/api

# Identificador de cliente OAuth de Google (Aplicación web). Debe ser el mismo
# valor en cliente y servidor; sin él, el acceso con Google queda oculto.
# El origen de la app debe figurar en «Orígenes de JavaScript autorizados».
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 Measurement ID (the public web stream ID).
VITE_GOOGLE_ANALYTICS_ID=G-F7DMMN328B

# Servidor: copiar estas variables a server/.env para desarrollo local.
PORT=3001
APP_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
DATABASE_URL=mysql://root:@localhost:3306/starcraft_tmg
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=
NODE_ENV=development
