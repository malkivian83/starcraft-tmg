  "race": "PROTOSS",

  "upgradeGlossary": {
    "leg_enhancements": {
      "phase": "MOVEMENT",
      "type": "ACTIVE",
      "cost": 1,
      "text": {
        "es": "Esta unidad realiza una acción de Movimiento de 2\". No cuenta para su límite de acciones.",
        "en": "This Unit performs a 2\" Move action. This does not count towards its action limit."
      }
    },
    "my_life_for_aiur": {
      "phase": "COMBAT",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Cuando esta unidad resuelve IMPACT, cada modelo elegible genera un dado de IMPACT adicional.",
        "en": "When this Unit resolves IMPACT, each eligible model generates 1 additional IMPACT die."
      }
    },
    "we_stand_as_one": {
      "phase": "COMBAT",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Cuando esta unidad hace un Ataque de Combate Cuerpo a Cuerpo, si el objetivo está trabado con al menos otra unidad amiga, su arma de cuerpo a cuerpo gana PRECISION (2).",
        "en": "When this Unit makes a Close Combat Attack, if the target is Engaged with at least 1 other Friendly Unit, this Unit's Close Combat Weapon gains PRECISION (2)."
      }
    },
    "zealous_round": {
      "phase": "ANY",
      "type": "REACTION",
      "cost": 0,
      "text": {
        "es": "Cuando esta unidad no está activada y recibe daño, el jugador que la controla puede darla por activada en esta fase (girando su Marcador de Activación) para reducir el Daño Total en 2.",
        "en": "When this Unit is not Activated and receives Damage, the controlling player may count this Unit as Activated in this Phase (flip its Activation Marker) to reduce the Total Damage by 2."
      }
    },
    "guidance": {
      "phase": "ASSAULT",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "El arma a distancia Glaive Cannon de esta unidad gana ANTI-EVADE (2).",
        "en": "This Unit's Glaive Cannon Ranged weapon gains ANTI-EVADE (2)."
      }
    },
    "resonating_glaives": {
      "phase": "ASSAULT",
      "type": "ACTIVE",
      "cost": 1,
      "text": {
        "es": "El Glaive Cannon de esta unidad gana BUFF RdA (1).",
        "en": "This Unit's Glaive Cannon gains BUFF RoA (1)."
      }
    },
    "glaive_strike": {
      "phase": "COMBAT",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Sustituye el ataque Strike por Glaive Strike, que perfora objetivos Light.",
        "en": "Replaces the Strike attack with Glaive Strike, which pierces Light targets."
      },
      "weapon": {
        "name": "Glaive Strike",
        "phase": "COMBAT",
        "range": "E",
        "target": "Ground",
        "rateOfAttack": "1",
        "hit": "4+",
        "surgeType": "Light",
        "surgeDice": "D3",
        "damage": "1",
        "keywords": ["PIERCE Light (2)"]
      }
    },
    "solid_field_projectors": {
      "phase": "MOVEMENT",
      "type": "ACTIVE",
      "cost": 1,
      "text": {
        "es": "Coloca una ficha de Force Field a menos de 8\" en un espacio libre. Las unidades de Tamaño 2 o menor no pueden atravesar los Force Fields. Los modelos de Tamaño 3 o más sí pueden pasar por encima, y entonces la ficha se retira.",
        "en": "Set a Force Field token Within 8\" in an unoccupied space. Units of Size 2 or lower cannot move across Force Fields. Models of Size 3 or more can move over it, and it's then removed."
      }
    },
    "hallucination": {
      "phase": "ASSAULT",
      "type": "REACTION",
      "cost": 0,
      "text": {
        "es": "Cuando una unidad enemiga declara un Ataque a Distancia contra una unidad amiga a menos de 4\", esa unidad amiga puede hacer una Tirada de Evasión contra ese ataque.",
        "en": "When an Enemy Unit declares a Ranged Attack against a Friendly Unit Within 4\", the targeted Friendly Unit is eligible to make an Evade Roll against that attack."
      }
    },
    "path_of_shadows": {
      "phase": "ANY",
      "type": "ACTIVE",
      "cost": 1,
      "text": {
        "es": "Esta unidad gana el estado HIDDEN hasta que realice otra acción.",
        "en": "This Unit gains HIDDEN Status until it performs another action."
      }
    },
    "fury_of_the_nerazim": {
      "phase": "ASSAULT",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Cuando esta unidad ataca a una unidad enemiga que ya ha sido activada durante esta fase, sus Particle Disruptors ganan INSTANT para ese ataque.",
        "en": "When this Unit attacks an Enemy Unit that has already been Activated during this Phase, its Particle Disruptors gain INSTANT for that attack."
      }
    }
  },

