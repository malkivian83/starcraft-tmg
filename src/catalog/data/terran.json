  "upgradeGlossary": {
    "agg_12": {
      "phase": "ASSAULT",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Un modelo nominado cambia su C-14 Rifle por un AGG-12 de largo alcance y perforación contra objetivos Armoured. Al portar un arma distinta, ese modelo resuelve sus ataques como un lote aparte.",
        "en": "A nominated model replaces its C-14 Rifle with an AGG-12. Carrying a different weapon, that model resolves its attacks as a separate Batch."
      }
    },
    "bayonet": {
      "phase": "COMBAT",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Sustituye el ataque Strike por una Bayonet, que duplica la Cadencia de Ataque en combate cuerpo a cuerpo.",
        "en": "Replaces the Strike attack with a Bayonet, doubling the Rate of Attack in close combat."
      }
    },
    "rocket_launcher": {
      "phase": "ASSAULT",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Un modelo nominado gana un Rocket Launcher además de su arma actual: fuego indirecto y largo alcance, sin renunciar al C-14 Rifle por ser SIDEARM.",
        "en": "A nominated model gains a Rocket Launcher in addition to its current weapon: indirect fire and long range, keeping the C-14 Rifle thanks to SIDEARM."
      }
    },
    "a13_flash_grenade_launcher": {
      "phase": "ANY",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Aumenta a 16\" el alcance de la habilidad especial Optical Flare.",
        "en": "Increase the Optical Flare special ability's Range to 16\"."
      }
    },
