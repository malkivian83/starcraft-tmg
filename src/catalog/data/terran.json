      "phase": "ANY",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "El Valor de Suministro de esta unidad cuenta como 0 al calcular la Reserva de Suministro.",
        "en": "This Unit's Supply Value counts as 0 when calculating the Supply Pool."
      }
    },
    "stabilizer_medpacks": {
      "phase": "ANY",
      "type": "PASSIVE",
      "cost": null,
      "text": {
        "es": "Cuando esta unidad resuelve una habilidad Life Support o Medpack, se trata como si tuviera un modelo adicional dentro del alcance al calcular los efectos de esa habilidad.",
        "en": "When this Unit resolves a Life Support or Medpack ability, treat it as having 1 additional model Within Range for calculating that ability's effects."
      }
    },
