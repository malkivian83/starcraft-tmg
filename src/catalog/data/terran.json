      "startingSlots": { "CORE": 3, "ELITE": 1, "SUPPORT": 1, "AIR": 1 },
      "resource": "CP",
      "resourcePerRound": 1,
      "abilities": [
        {
          "name": "Tactical Retreat",
          "phase": "MOVEMENT",
          "type": "ACTIVE",
          "cost": null,
          "fromUpgrade": false,
          "text": {
            "es": "La unidad activa ignora la penalización de Desenganche durante el resto de la ronda.",
            "en": "The active Unit ignores the Disengage penalty for the remainder of the Round."
          }
        },
        {
          "name": "Terran Tenacity",
          "phase": "MOVEMENT",
          "type": "ACTIVE",
          "cost": null,
          "fromUpgrade": false,
          "text": {
            "es": "Una vez por partida. Reclama de inmediato el Marcador de Primer Jugador. Ningún otro jugador puede reclamarlo durante el resto de esta fase.",
            "en": "Once per Game. Immediately claim the First Player Marker. No other player may claim the First Player Marker for the remainder of this Phase."
          }
        }
      ],
      "imageRef": "cards/terran/faction-terran-armed-forces.png"
    },
    {
      "id": "terran.faction.raynors_raiders",
      "seedId": 1202,
      "race": "TERRAN",
      "name": "Raynor's Raiders",
      "tags": ["TERRAN", "RAYNOR'S RAIDERS"],
      "startingSlots": { "CORE": 3, "HERO": 1, "SUPPORT": 1, "AIR": 1 },
      "resource": "CP",
      "resourcePerRound": 1,
      "abilities": [
        {
          "name": "Rapid Ingress",
          "phase": "MOVEMENT",
          "type": "ACTIVE",
          "cost": null,
          "fromUpgrade": false,
          "text": {
            "es": "Coloca una unidad Point Defence Drone amiga en cualquier punto del campo de batalla, a más de 1\" de cualquier modelo enemigo. Retira esta unidad al final de la ronda.",
            "en": "Set a Friendly Point Defence Drone Unit anywhere on the battlefield, more than 1\" away from any Enemy model. Remove this Unit at the End of the Round."
          }
        },
        {
          "name": "Ready for Pickup?",
          "phase": "MOVEMENT",
          "type": "ACTIVE",
          "cost": null,
          "fromUpgrade": false,
          "text": {
            "es": "Una vez por partida. La unidad activa resuelve el efecto PLACE (12). Los modelos colocados por este efecto no pueden situarse dentro del Alcance de Trabazón de ninguna unidad enemiga. Esto se resuelve en lugar de realizar una acción estándar.",
            "en": "Once Per Game. The active Unit resolves the PLACE (12) effect. Models set by this effect cannot be set up Within the Engagement Range of any Enemy Unit. This resolves instead of performing a standard action."
          }
        }
      ],
      "imageRef": "cards/terran/faction-raynors-raiders.png"
    }
  ],

